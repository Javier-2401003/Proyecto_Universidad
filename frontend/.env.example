# Copie este archivo como ".env" (en esta misma carpeta) si el backend no esta
# en http://localhost:3000. Sin ".env" se usa ese valor por defecto.
VITE_API_URL=http://localhost:3000

# Carga de lotes: mientras el backend no tenga los endpoints, la pantalla usa
# datos simulados. Ponga "false" para probar contra el backend real.
VITE_SIMULAR_CARGA_LOTES=true
