# Copie este archivo como ".env" (en esta misma carpeta) si el backend no esta
# en http://localhost:3000. Sin ".env" se usa ese valor por defecto.
VITE_API_URL=http://localhost:3000

# Carga de lotes y detalle de llamada: mientras el backend no tenga los
# endpoints de /llamadas, se usan datos simulados. Ponga "false" para probar
# contra el backend real.
VITE_SIMULAR_LLAMADAS=true
