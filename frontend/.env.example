# Copie este archivo como ".env" (en esta misma carpeta) si el backend no esta
# en http://localhost:3000. Sin ".env" se usa ese valor por defecto.
VITE_API_URL=http://localhost:3000

# Datos simulados (ver frontend/README.md, "Backend real y modo de prueba").
# Carga de lotes y detalle de llamada usan el backend real; ponga "true" para
# mostrarlas con datos de ejemplo (por ejemplo, en una demo sin analisis de audio).
VITE_SIMULAR_LLAMADAS=false
# Estadisticas del inicio: simuladas hasta que exista GET /estadisticas/resumen.
# Ponga "false" para probar el endpoint real.
VITE_SIMULAR_ESTADISTICAS=true
