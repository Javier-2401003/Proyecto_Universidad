# Copie este archivo como ".env" (en esta misma carpeta) si el backend no esta
# en http://localhost:3000. Sin ".env" se usa ese valor por defecto.
VITE_API_URL=http://localhost:3000

# Datos simulados (ver frontend/README.md, "Backend real y modo de prueba").
# Todo usa el backend real; ponga "true" para mostrar una pantalla con datos de
# ejemplo (por ejemplo, en una demo sin backend o sin analisis de audio).
# Carga de lotes y detalle de llamada:
VITE_SIMULAR_LLAMADAS=false
# Estadisticas del inicio:
VITE_SIMULAR_ESTADISTICAS=false
