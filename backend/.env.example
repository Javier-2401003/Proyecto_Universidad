# Copie este archivo como ".env" (en esta misma carpeta) y ajuste los valores.
# El archivo ".env" NO se sube a GitHub. Este ".env.example" si, sin secretos reales.

# --- Servidor ---
PORT=3000
# Origen del frontend React (Vite usa 5173 por defecto)
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (Wamp: usuario root sin contrasena por defecto) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_vocalanalytics

# --- Seguridad ---
# Cadena larga y aleatoria. Genere una con:
#   node --input-type=module -e "import {randomBytes} from 'crypto'; console.log(randomBytes(48).toString('hex'))"
JWT_SECRET=cambie-esto-por-una-cadena-larga-y-aleatoria
# Vida del token de acceso (Blueprint 4.1: 60 minutos)
JWT_EXPIRES_IN_SECONDS=3600
# Costo de Bcrypt (Blueprint 4.2: 12)
BCRYPT_COST=12
# Limite de intentos de login por IP en 15 minutos
LOGIN_MAX_INTENTOS=10

# --- Carga de audios por lotes (docs/api.md) ---
# Cantidades de audios permitidas por lote y tamano maximo de cada audio.
# El frontend repite estos mismos valores para avisar antes de subir.
LOTE_TAMANOS_PERMITIDOS=5,10,15
AUDIO_MAX_MB=25

# --- Primer SuperAdmin (npm run crear-superadmin) y pruebas (npm test) ---
# Invente una contrasena propia (minimo 8 caracteres). Este archivo .env solo
# existe en su computadora: nunca se sube a GitHub.
SEED_ADMIN_NOMBRE=
SEED_ADMIN_CORREO=
SEED_ADMIN_PASSWORD=
